<?xml version="1.0" encoding="utf-8"?>
<!-- 暗号化されていない http 通信を一切しない。ユーザーが入れた証明書も信頼しない（通信の盗み見対策） -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
